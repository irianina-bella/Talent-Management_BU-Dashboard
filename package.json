{
  "name": "talent-analytics-compass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:alignment && npm run test:matrix && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:alignment": "esbuild tests/aspirationAlignment.test.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/alignment.test.cjs && node node_modules/.cache/alignment.test.cjs",
    "test:matrix": "esbuild tests/matrix.test.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/matrix.test.cjs && node node_modules/.cache/matrix.test.cjs"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "jspdf": "2.5.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "esbuild": "0.21.5",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.19"
  },
  "engines": {
    "node": "22.x"
  }
}
